# ============================================================
# HIDRO SELF-SERVICE - variables de entorno (EJEMPLO)
# Copiar a apps/api/.env  —  NUNCA subir valores reales al repo
# ============================================================

# --- General ---
NODE_ENV=development
API_PORT=3020
# Host de escucha: 127.0.0.1 en desarrollo; en producción/contenedor usar 0.0.0.0
API_HOST=127.0.0.1
# URL pública del frontend (usada para QR, CORS y URLs de retorno de Mercado Pago)
PUBLIC_APP_URL=http://localhost:5173
# URL pública de la API (a donde Mercado Pago envía los webhooks).
# Si front y API se despliegan separados, DEBE apuntar a la API.
# Vacío => usa PUBLIC_APP_URL (modo local).
PUBLIC_API_URL=
# trust proxy para express-rate-limit detrás de un reverse proxy (default 1 en producción)
TRUST_PROXY=0

# --- Base de datos ---
# PostgreSQL real (producción): postgres://usuario:clave@host:5432/hidro
# Si se deja vacío, la API ejecuta PostgreSQL EMBEBIDO (PGlite, motor PostgreSQL 16
# dentro del proceso) y persiste en DB_FILE. DEMO MODE: no requiere servidor externo.
DATABASE_URL=
DB_FILE=./.data/hidro-db

# --- Pagos ---
# demo       -> DemoPaymentProvider (no requiere credenciales). DEMO MODE.
# mercadopago -> MercadoPagoPaymentProvider (requiere las 3 variables siguientes)
PAYMENT_PROVIDER=demo
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Solo en NODE_ENV=production con PAYMENT_PROVIDER=demo: un ESP32 real no recibe autorizaciones
# (cualquiera puede aprobar un pago demo). true únicamente para la prueba en banco. [STOP-HUMANO]
# ALLOW_DEMO_PAYMENTS_ON_DEVICE=false

# --- Seguridad ---
# Valores de desarrollo. En NODE_ENV=production la API NO arranca si JWT_SECRET o
# DEVICE_AUTH_SECRET faltan, son estos valores o tienen menos de 32 caracteres, ni si
# ADMIN_PASSWORD es la demo o tiene menos de 12. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me
DEVICE_AUTH_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@hidro.local
ADMIN_PASSWORD=hidro-demo-2025

# --- Simulador de dispositivo (DEMO MODE) ---
# Simula el ESP32 dentro de la API (heartbeat, autorización, pulsador, relay, timer, NVS).
# Default: true en desarrollo, false en producción.
# En NODE_ENV=production se prende SOLO poniendo esta variable en true a propósito (ADR-047:
# mostrarle el flujo completo al dueño sin hardware). Mientras esté prendida:
#   - la web muestra un banner "MODO DEMO — máquina simulada" en la landing y en la máquina;
#   - las máquinas se ven ONLINE por heartbeats simulados, NO por un ESP32 real;
#   - exige PAYMENT_PROVIDER=demo (con mercadopago la API no arranca).
# APAGARLA antes de conectar el ESP32 de verdad. [STOP-HUMANO]
DEVICE_SIMULATOR=true
# Factor de aceleración SOLO para desarrollo/testing (nunca en producción, se fuerza a 1).
# 1  -> tiempo real (180s)
# 10 -> 180s simulados en 18s
# 60 -> 180s simulados en 3s
TEST_SPEED_FACTOR=10

# --- Tiempos del dominio ---
HEARTBEAT_INTERVAL_MS=5000
AUTH_TTL_SECONDS=300
# Máximo que una orden sin pagar ocupa la máquina (bloqueo gratuito) — libera en ~2 min
PAYMENT_PENDING_TIMEOUT_SECONDS=120
# Límite de lavados por día POR PATENTE (decisión del cliente: 2)
DAILY_WASH_LIMIT=2

# --- Seed demo ---
# Solo decide las patentes demo AE100AA/AE200AA (máquinas, dispositivos y admin se crean
# siempre). Default: true en desarrollo, false en producción. Comentado a propósito para que
# pegar este archivo en un deploy no siembre patentes con tarifa remis/socio.
# SEED_DEMO=true

# --- CORS (separado por comas) ---
CORS_ORIGINS=http://localhost:5173
